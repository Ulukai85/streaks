POSTGRES_DB=streaks
POSTGRES_USER=streaks
POSTGRES_PASSWORD=streaks_dev

# Required — the API refuses to boot on an empty Users table without
# SEED_USER_PASSWORD set (see api/Api/Data/DatabaseInitializer.cs,
# decision #12 in docs/phase-3-plan.md). No dev-friendly default shipped
# here on purpose; set both before `docker compose up` on a fresh volume.
SEED_USER_NAME=
SEED_USER_PASSWORD=
