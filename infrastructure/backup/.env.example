# Backup process env — REFERENCE COPY ONLY.
#
# This process runs on the host as a systemd service (Stage D,
# docs/phase-5-plan.md), outside infrastructure/docker-compose.yml — same
# reasoning as Grafana Alloy (ADR 0011): it needs to survive independent of
# the app containers, and has no reason to live in Compose. The real, filled
# in file lives only at /opt/streaks/backup/.env on the VM (mode 600,
# root-only) and is never committed — same trust tier as infrastructure/.env.
#
# RESTIC_PASSWORD in particular is not recoverable if lost: it encrypts
# every snapshot in the B2 bucket. Store it somewhere durable outside the
# VM (e.g. a password manager) before running `restic init`.
#
# Uses B2's S3-compatible API, not restic's native b2: backend — restic's
# own docs currently advise against the native backend ("issues with the
# current B2 library") in favor of S3-compatible. <region> and <bucket-name>
# come from the B2 bucket's "Endpoint" field in the Backblaze dashboard,
# e.g. s3.us-west-004.backblazeb2.com. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# are restic's generic S3 credential vars — set them to the B2 application
# key's keyID / applicationKey (not a real AWS account).

RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket-name>
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must match infrastructure/.env's POSTGRES_USER / POSTGRES_DB on the same
# host — backup.sh execs into the running `postgres` container using these.
POSTGRES_USER=streaks_admin
POSTGRES_DB=streaks
